rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // マスターデータ（部位・種目マスター等）: ログインユーザーのみ読み取り、クライアントからの書き込みは禁止
    match /master_data/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ユーザードキュメント本体（プロフィール・目標など）
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- マネタイズ: コイン台帳（付与・消費・FIFO は Cloud Functions のみ） ---
    match /users/{userId}/coin_transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // --- エンゲージメント: ミッション等の監査ログ（書き込みはサーバーのみ想定） ---
    match /users/{userId}/mission_events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ユーザーサブコレクション（明示リストのみクライアント書き込み可）
    // 注意: {document=**} と併用すると「いずれかの allow が true なら許可」になるため、
    // 改ざん禁止パスは上で個別に deny write したうえで、ここでは残ラインのみ列挙する。
    match /users/{userId}/workouts/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/food_logs/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/food_dictionary/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/routines/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/custom_exercises/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/daily_advice/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/daily_metrics/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
