## NoteFit AI - local env example
## Copy to `.env` and fill values (DO NOT commit `.env`).

# RevenueCat
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# AdMob (unit ids)
ADMOB_BANNER_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=

# Optional: callable override URL for reward coin grant
# Example: https://asia-northeast1-<project-id>.cloudfunctions.net/grantRewardAdCoins
GRANT_REWARD_CALLABLE_URL=

