## NoteFit AI - local env example
## Copy to `.env` and fill values (DO NOT commit `.env`).

# App variant: `development` (default locally) installs com.takimoto.shoa.notefitai.dev
# so Play Store internal test (com.takimoto.shoa.notefitai) can stay on the same device.
# Set to `production` only when you need to test the store package locally.
APP_VARIANT=development

# RevenueCat
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# AdMob (unit ids — leave empty to use test IDs)
ADMOB_BANNER_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=

# AdMob App IDs (production)
# IMPORTANT: Before release, replace the test app IDs in app.json
# android: ca-app-pub-3940256099942544~3347511713  ← TEST (replace with real)
# ios:     ca-app-pub-3940256099942544~1458002511  ← TEST (replace with real)

# Optional: callable override URL for reward coin grant
# Example: https://asia-northeast1-<project-id>.cloudfunctions.net/grantRewardAdCoins
GRANT_REWARD_CALLABLE_URL=

# Dev server / Metro (usually leave unset — Expo picks your LAN IP with `expo start --lan`)
# Do NOT set these to localhost/127.0.0.1 or physical devices cannot reach Metro.
# REACT_NATIVE_PACKAGER_HOSTNAME=
# EXPO_USE_LOCAL_NETWORK=
# HOST=

