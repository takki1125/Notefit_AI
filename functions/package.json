{
  "name": "notefit-ai-functions",
  "description": "Cloud Functions for NoteFit AI (food PFC analysis, etc.)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "rimraf lib && tsc",
    "build:watch": "tsc -w",
    "deploy": "npm run build && firebase deploy --only functions",
    "lint": "eslint --ext .ts src"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "private": true
}
